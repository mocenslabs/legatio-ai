# =============================================================================
# Legatio AI — Production / staging secrets (Northflank + Neon + Cloudflare)
# Never commit real values. Set these in Northflank service env / CF Pages.
# =============================================================================

ENVIRONMENT=production
DJANGO_SETTINGS_MODULE=legatio.settings.production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-long-random-string
DJANGO_ALLOWED_HOSTS=api.yourdomain.com,your-northflank-host.northflank.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.yourdomain.com,https://your-pages.pages.dev
DJANGO_CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://your-pages.pages.dev
DJANGO_SECURE_SSL_REDIRECT=True

# Neon (SSL required)
POSTGRES_HOST=ep-xxxx.region.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=legatio
POSTGRES_USER=legatio_owner
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# Redis on Northflank (or Upstash)
REDIS_URL=redis://:password@redis-host:6379/0
CELERY_BROKER_URL=redis://:password@redis-host:6379/0
CELERY_RESULT_BACKEND=redis://:password@redis-host:6379/1
CELERY_TASK_ALWAYS_EAGER=False

JWT_SECRET_KEY=replace-with-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Valid Fernet key (32 url-safe base64 bytes)
ENCRYPTION_KEY=
SERVER_SIGNING_KEY=

BILLING_ENABLED=False
LLM_ENABLED=False

# Cloudflare Pages build-time
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
# VITE_DEFAULT_LOCALE=en
