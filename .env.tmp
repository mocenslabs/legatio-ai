# =============================================================================
# Legatio AI — Environment Variables Template
# =============================================================================
# Este archivo es la plantilla oficial de variables de entorno.
# NO contiene secretos reales.
# Copiar a .env para desarrollo local:
#
#   cp .env.example .env
#
# El archivo .env NUNCA debe ser commiteado.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
ENVIRONMENT=local
TZ=UTC
COMPOSE_PROJECT_NAME=legatio
PYTHONUNBUFFERED=1

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=legatio.settings.development
DJANGO_SECRET_KEY=sRSsdiBc3+DLAuOrCCBh841o4HKyLwyFeOW+fBx05IsGSulPe/TcLYdjj/8nBlTO
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/
DJANGO_LANGUAGE_CODE=en
DJANGO_TIME_ZONE=UTC
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
DJANGO_SECURE_SSL_REDIRECT=False

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=legatio
POSTGRES_USER=legatio
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_SSLMODE=disable

# -----------------------------------------------------------------------------
# Redis / Celery
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# Audit hash chain locking
AUDIT_CHAIN_LOCK_KEY=legatio:audit_chain_lock
AUDIT_CHAIN_LOCK_TTL_SECONDS=10

# -----------------------------------------------------------------------------
# JWT / 2FA
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=__JWT_SECRET_KEY__
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ISSUER=legatio
JWT_AUDIENCE=legatio-clients

TOTP_ISSUER=LegatioAI
TOTP_DIGITS=6
TOTP_INTERVAL=30

# -----------------------------------------------------------------------------
# Encryption and signing
# -----------------------------------------------------------------------------
# ENCRYPTION_KEY must be a base64-encoded 32-byte key for AES-256-GCM.
ENCRYPTION_KEY=__ENCRYPTION_KEY__

# SERVER_SIGNING_KEY is used for HMAC-SHA256 agreement signatures.
SERVER_SIGNING_KEY=__SERVER_SIGNING_KEY__
AGREEMENT_SIGNATURE_ALGORITHM=HMAC-SHA256

# -----------------------------------------------------------------------------
# Business defaults
# -----------------------------------------------------------------------------
APPROVAL_EXPIRATION_HOURS=24
NEGOTIATION_DEFAULT_TTL_HOURS=24
NEGOTIATION_MAX_ROUNDS_DEFAULT=10
EXTERNAL_AGENT_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------
# MVP Phase 0-5 must run with simulated agents only.
LLM_ENABLED=False
LLM_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# Email / notifications
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@legatio.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# -----------------------------------------------------------------------------
# Frontend URLs
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# -----------------------------------------------------------------------------
# Nginx / ports
# -----------------------------------------------------------------------------
NGINX_HTTP_PORT=80
BACKEND_INTERNAL_PORT=8000
FRONTEND_INTERNAL_PORT=5173

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=
ENABLE_REQUEST_CORRELATION_ID=True
