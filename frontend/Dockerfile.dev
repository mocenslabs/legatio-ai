# ============================================================
# Legatio AI — Frontend Development Dockerfile
# ============================================================
# Multi-stage build: uses Node.js 20 Alpine with hot-reload.
# Only used for development; production uses a separate Dockerfile.
# ============================================================

FROM node:20-alpine

# Set working directory
WORKDIR /app

# Install system dependencies for native modules
RUN apk add --no-cache \
    python3 \
    make \
    g++

# Copy package files first for better layer caching
COPY package.json package-lock.json* ./

# Install dependencies (including devDependencies)
RUN npm ci

# Copy the rest of the application code
COPY . .

# Expose the Vite dev server port
EXPOSE 5173

# Default command: start the Vite dev server with HMR
# (can be overridden in docker-compose.yml)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
