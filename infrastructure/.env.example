# Django
SECRET_KEY=your-super-secret-production-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database
DB_NAME=legatio
DB_USER=legatio
DB_PASSWORD=your-secure-db-password
DB_HOST=db
DB_PORT=5432
DATABASE_SSL_REQUIRE=False  # <-- NUEVO: True si tu proveedor de DB lo exige (ej. Render, Railway)

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Throttling (Production rates)
# <-- NUEVO: Tasas más estrictas para producción
THROTTLE_BURST_RATE=60/min
THROTTLE_SUSTAINED_RATE=1000/day
THROTTLE_ANON_BURST_RATE=10/min

# Security
# <-- NUEVO: Generalmente False si hay un proxy (Nginx/Cloudflare) manejando HTTPS
SECURE_SSL_REDIRECT=False

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# Email
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Sentry
SENTRY_DSN=
